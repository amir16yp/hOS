CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_HID=y
CONFIG_HID_SUPPORT=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_UNIX=y
CONFIG_NET=y
# IPv4 is what hos-netd, its DHCP client and hos-ntpd speak; without it every
# AF_INET socket fails with EAFNOSUPPORT and even loopback stays unconfigured.
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
# AF_PACKET carries wpa_supplicant's EAPOL frames.
CONFIG_PACKET=y
CONFIG_NET_CORE=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
# Wired adapters: the virtual machines this image targets, and the PCI parts
# most commonly found in the physical machines it installs on.
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=y
CONFIG_VIRTIO_NET=y
# USB Ethernet adapters, which laptops without a socket depend on.
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
# The 802.11 stack wpa_supplicant drives through nl80211. Adapters that need
# firmware files cannot work in this image, which carries none; ath9k parts
# run from their own EEPROM and do.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_UNWINDER_ORC=n
CONFIG_STACK_VALIDATION=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_MODULES=n
CONFIG_LOCALVERSION="-hos"
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_PRINTK_TIME=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_ELF_CORE=y
CONFIG_COREDUMP=y
CONFIG_AUTOFS_FS=n
CONFIG_LOCALVERSION_AUTO=n
CONFIG_PANIC_TIMEOUT=0
