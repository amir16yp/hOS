CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_VESA=y
CONFIG_EFI=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_DRM_BOCHS=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO_I8042=y
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT2_FS=y
CONFIG_EXT4_FS=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_ACPI=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_HID=y
CONFIG_HID_SUPPORT=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_UNIX=y
CONFIG_NET=y
# IPv4 is what hos-netd, its DHCP client and hos-ntpd speak; without it every
# AF_INET socket fails with EAFNOSUPPORT and even loopback stays unconfigured.
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
# AF_PACKET carries wpa_supplicant's EAPOL frames.
CONFIG_PACKET=y
CONFIG_NET_CORE=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
# Wired adapters: the virtual machines this image targets, and the PCI parts
# most commonly found in the physical machines it installs on.
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=y
CONFIG_VIRTIO_NET=y
# USB Ethernet adapters, which laptops without a socket depend on.
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
# The 802.11 stack wpa_supplicant drives through nl80211. Adapters that need
# firmware files cannot work in this image, which carries none; ath9k parts
# run from their own EEPROM and do.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_UNWINDER_ORC=n
CONFIG_STACK_VALIDATION=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_MODULES=n
CONFIG_LOCALVERSION="-hos"
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_PRINTK_TIME=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_ELF_CORE=y
CONFIG_COREDUMP=y
CONFIG_AUTOFS_FS=n
CONFIG_LOCALVERSION_AUTO=n
CONFIG_PANIC_TIMEOUT=0
