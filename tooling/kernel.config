CONFIG_FB_DEVICE=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FB_VGA16=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_RADEON=y
CONFIG_FB_NVIDIA=y
